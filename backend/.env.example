# MongoDB connection string (MongoDB Atlas or local)
# Format: mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# Get from MongoDB Atlas → Connect → Connection String
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT secret for signing authentication tokens
# MUST be at least 32 characters and cryptographically random
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This MUST be changed for production - use a strong random value
JWT_SECRET=change_me_to_a_long_random_secret_minimum_32_characters

# Server port (Vercel/Railway will override this in production)
PORT=5000

# Node environment
# development = local development with logging
# production = optimized, no debug logs
NODE_ENV=development

# Frontend origin for CORS configuration
# development: http://localhost:3000
# production: https://your-site.vercel.app (NO trailing slash)
FRONTEND_URL=http://localhost:3000

# GitHub webhook secret (optional, for sync service)
# If you're using the GitHub sync feature, generate a random string here
GITHUB_WEBHOOK_SECRET=

# LinkedIn API credentials (optional, for auto-posting feature)
# Only needed if you want to auto-post to LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

